# ==============================================
# MotorDesk Docker configuration
# ==============================================
# Copy this file to .env and adjust the values:
#   cp .env.example .env
# ==============================================

# Stack name for container, volume and network names.
# Change this when multiple stacks run on the same server.
STACK_NAME=motordesk

# Public domain without https://. Keep the example value for local HTTP-only use.
DOMAIN=erp.example.com

# E-mail for Let's Encrypt. Required when real SSL certificates are used.
CERTBOT_EMAIL=admin@example.com

# PostgreSQL
# POSTGRES_USER must stay postgres while the bundled schemas contain
# OWNER TO postgres statements.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_AUTH_NAME=motordesk_auth
DB_COMPANY_NAME=motordesk_company

# External PostgreSQL port for admin tools such as pgAdmin.
DB_EXTERNAL_PORT=5433

# Application settings
APP_TIMEZONE=Europe/Berlin
APP_DEBUG=false

# Web server ports
WEB_HTTP_PORT=8080
WEB_HTTPS_PORT=8443
ADMIN_HTTP_PORT=8082
ADMIN_HTTPS_PORT=8444

# Session
SESSION_COOKIE_NAME=motordesk
SESSION_COOKIE_SAMESITE=Strict

# Demo mode
DEMO_MODE=false
DEMO_INACTIVITY_MINUTES=20

# ----- Demo overlay (docker/docker-compose.demo.yml + ./scripts/docker.sh demo-up) -----
# Absolute paths to pg_dump files on the Docker host.
# Both plain .sql and gzip-compressed .sql.gz dumps are supported.
DEMO_AUTH_DUMP=/absolute/path/to/auth.sql
DEMO_COMPANY_DUMP=/absolute/path/to/company.sql

# Absolute path to demo vehicle registration scan data.
# The directory is mounted read-only to backend/api/demo/data.
DEMO_SCAN_DATA=/var/www/docker/motordesk-demo-data
